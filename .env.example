# ── Eesa Documents plugin — required environment (set on the Coolify service) ──

# Postgres (metadata + pointers only — NEVER file bytes). Supabase/Neon/RDS need SSL.
DATABASE_URL=postgres://user:pass@host:5432/documents
# PGSSL=disable    # only for a plain/local Postgres

# Eesa platform trust (verify the gateway's RS256 tokens via JWKS)
EESA_JWKS_URL=https://api.eesa.ai/.well-known/jwks.json
EESA_TOKEN_ISSUER=eesa
# Shared secret the gateway sends as X-Eesa-Gateway-Secret on server-side MCP calls.
# REQUIRED: /mcp refuses every call while this is unset (the manifest declares
# gatewayOnly, so failing open would advertise a protection that isn't there).
# Generate: openssl rand -hex 32   (store here + in the platform's connection, NEVER in git)
PLUGIN_GATEWAY_SECRET=
# ALLOW_UNGATED_MCP=1   # local dev ONLY, when you aren't running a gateway. Never set in production.

# This plugin's own public base URL (used to build the OAuth redirect URI)
PLUGIN_BASE_URL=https://documents.plugins.bibekpoudel.com

# Google OAuth (the plugin owns its OWN OAuth — one login per tenant, full Drive scope).
# In Google Cloud console add this EXACT authorized redirect URI:
#   <PLUGIN_BASE_URL>/api/connect/google_drive/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts stored OAuth tokens at rest (AES-256-GCM). Generate: openssl rand -hex 32
PLUGIN_ENC_KEY=

# Qdrant — point at the SAME instance the platform uses. Copy the URL + key from
# the super-admin's saved Qdrant settings (Admin -> Qdrant), which is where the
# platform's own workflow and memory indexes read their config from.
# One collection is created per tenant on first use: <prefix>_<tenant id>.
# A URL with no port is given :443 for https and :6333 for http, because
# qdrant-client otherwise dials 6333 behind an HTTPS proxy and simply hangs.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=eesa_docs

# Optional tuning
# Embedding model. MUST match the platform (Admin -> Qdrant -> embedding model),
# so search behaves the same here as everywhere else in Eesa. Changing this
# invalidates existing collections: Qdrant is dimension-locked.
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# INGEST_MAX_FILE_MB=25
