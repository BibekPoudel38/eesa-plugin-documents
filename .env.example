# ── Eesa Documents plugin — required environment (set on the Coolify service) ──

# Postgres (metadata + pointers only — NEVER file bytes). Supabase/Neon/RDS need SSL.
DATABASE_URL=postgres://user:pass@host:5432/documents
# PGSSL=disable    # only for a plain/local Postgres

# Eesa platform trust (verify the gateway's RS256 tokens via JWKS)
EESA_JWKS_URL=https://api.eesa.ai/.well-known/jwks.json
EESA_TOKEN_ISSUER=eesa
# Shared secret the gateway sends as X-Eesa-Gateway-Secret on server-side MCP calls.
# Generate: openssl rand -hex 32   (store here + in the platform's connection, NEVER in git)
PLUGIN_GATEWAY_SECRET=

# This plugin's own public base URL (used to build the OAuth redirect URI)
PLUGIN_BASE_URL=https://documents.plugins.bibekpoudel.com

# Google OAuth (the plugin owns its OWN OAuth — one login per tenant, full Drive scope).
# In Google Cloud console add this EXACT authorized redirect URI:
#   <PLUGIN_BASE_URL>/api/connect/google_drive/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts stored OAuth tokens at rest (AES-256-GCM). Generate: openssl rand -hex 32
PLUGIN_ENC_KEY=

# Qdrant (the plugin's OWN vector index — tenant-partitioned). Self-hosted on Coolify.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Optional tuning
# EMBED_MODEL=bge-small-en-v1.5
# INGEST_MAX_FILE_MB=25
